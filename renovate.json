{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/London",
  "enabledManagers": ["github-actions"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "dependencyDashboard": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "postUpgradeTasks": {
    "commands": ["scripts/check-actions.sh --renovate"],
    "fileFilters": [".validation-failed"],
    "executionMode": "branch"
  },
  "packageRules": [
    {
      "description": "This repository's own composite actions are tracked at @main by design.",
      "matchPackageNames": ["lukaszraczylo/shared-actions"],
      "enabled": false
    },
    {
      "description": "Minor and patch bumps merge on their own once the validate check is green.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Every consumer calls these actions at @main, so a major bump waits for a human.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major"]
    }
  ]
}
